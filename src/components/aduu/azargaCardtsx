  ner: string;
  imageUri: string; // зургийн зам Uri
  onPress: () => void; // карт дээр дарахад ажиллах функц
}

export default function AzargaCard({
  ner,
  imageUri,
  onPress,
}: AzargaCardProps) {
  return (
    <TouchableOpacity style={styles.cardContainer} onPress={onPress}>
      {imageUri ? (
